# Copy to .env (gitignored). The CLI loads it at start; values are never written to artifacts or logs.
ANTHROPIC_API_KEY=
# Operator credentials for the mock app. Artifacts reference them as {{secrets.APP_USER}} / {{secrets.APP_PASSWORD}}.
APP_USER=teller01
APP_PASSWORD=demo-only-password
# A tenant's replay (--tenant b) uses that bank's own operator only, never the ones above (D26). In the mock every
# bank has the same demo operator.
APP_USER__B=teller01
APP_PASSWORD__B=demo-only-password
APP_USER__C=teller01
APP_PASSWORD__C=demo-only-password
