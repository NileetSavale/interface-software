{
  "schemaVersion": "1",
  "capability": {
    "id": "core_banking.open_sub_account",
    "version": "1.0.0",
    "title": "Prepare a new sub-account for a member",
    "description": "Fills in the new sub-account form for a member and stops at the review screen. Opening the account (Confirm) is left to a person."
  },
  "app": {
    "product": "mock-core-banking",
    "versionRange": ">=1.0 <2.0",
    "surface": "web",
    "entryPath": "/"
  },
  "status": "approved",
  "provenance": {
    "discoveryRunId": "disc_20261115T072446Z_c5d86f",
    "recordedAt": "2026-11-15T07:25:07+00:00",
    "model": "claude-sonnet-5-5"
  },
  "inputs": {
    "memberId": {
      "type": "string",
      "description": "5-digit member number",
      "pattern": "^[0-9]{5}$",
      "sensitive": true,
      "identifies": "member"
    },
    "accountType": {
      "type": "enum",
      "description": "Kind of sub-account",
      "values": [
        "Savings",
        "Checking",
        "Certificate",
        "Holiday Club"
      ],
      "sensitive": false
    },
    "nickname": {
      "type": "string",
      "description": "Nickname shown on statements",
      "pattern": "^[A-Za-z ]{1,20}$",
      "sensitive": false
    },
    "initialDeposit": {
      "type": "string",
      "description": "Opening deposit in dollars, e.g. 250.00",
      "pattern": "^[0-9]+\\.[0-9]{2}$",
      "sensitive": true
    }
  },
  "outputs": {},
  "outcomes": [
    {
      "code": "APP_ERROR",
      "kind": "fatal",
      "at": "any",
      "detect": {
        "kind": "visible",
        "text": {
          "matches": "(?i)internal server error|an unexpected error|service unavailable"
        }
      },
      "description": "The application failed. Stop and keep the evidence."
    },
    {
      "code": "PERMISSION_DENIED",
      "kind": "business",
      "at": "any",
      "detect": {
        "kind": "visible",
        "text": {
          "matches": "(?i)not authori[sz]ed|access denied|insufficient (privileges|permissions)"
        }
      },
      "description": "The operator account may not do this. An answer for the caller, not a fault."
    },
    {
      "code": "UNEXPECTED_DIALOG",
      "kind": "escalate",
      "at": "any",
      "detect": {
        "kind": "visible",
        "role": "dialog"
      },
      "description": "A dialog the capability doesn't know. A person decides."
    },
    {
      "code": "SLOW_LOAD",
      "kind": "recoverable",
      "at": "any",
      "detect": {
        "kind": "visible",
        "text": {
          "matches": "(?i)^\\s*(loading|please wait)\\b"
        }
      },
      "recovery": {
        "do": {
          "kind": "wait",
          "timeoutMs": 5000
        },
        "maxAttempts": 2,
        "resume": "step"
      },
      "description": "The app shows a wait message. Wait longer, then carry on."
    },
    {
      "code": "PASSWORD_REMINDER",
      "kind": "recoverable",
      "at": "any",
      "detect": {
        "kind": "visible",
        "text": {
          "matches": "(?i)your password expires in \\d+ days?"
        }
      },
      "recovery": {
        "do": {
          "kind": "click",
          "target": {
            "frame": [
              "main"
            ],
            "strategies": [
              {
                "kind": "role",
                "role": "button",
                "name": "Remind me later"
              },
              {
                "kind": "text",
                "text": "Remind me later"
              }
            ]
          }
        },
        "maxAttempts": 1,
        "resume": "step"
      },
      "description": "The product's password-expiry notice, declared at review. Dismiss it with Remind me later, never Change password, and carry on."
    },
    {
      "code": "SESSION_EXPIRED",
      "kind": "escalate",
      "at": "any",
      "detect": {
        "kind": "visible",
        "text": {
          "matches": "(?i)session (has )?(expired|timed out)"
        }
      },
      "description": "The session ended part-way through a change. A person checks what was saved."
    },
    {
      "code": "MEMBER_NOT_FOUND",
      "kind": "business",
      "at": "any",
      "detect": {
        "kind": "visible",
        "text": {
          "matches": "(?i)No members found"
        }
      },
      "description": "The member search returned \"No members found\" for the supplied member number, so the sub-account form could not be opened. (learned from probe: a member number that doesn't exist)"
    },
    {
      "code": "DEPOSIT_BELOW_MINIMUM",
      "kind": "business",
      "at": "any",
      "detect": {
        "kind": "visible",
        "text": {
          "matches": "(?i)Minimum opening deposit is"
        }
      },
      "description": "The Open Sub-Account form came back with a message giving the minimum opening deposit, so the below-minimum deposit was rejected and the review screen was not reached. (learned from probe: an opening deposit below the minimum)"
    }
  ],
  "policy": {
