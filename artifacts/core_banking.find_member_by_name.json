{
  "schemaVersion": "1",
  "capability": {
    "id": "core_banking.find_member_by_name",
    "version": "1.0.0",
    "title": "Find a member by last name and date of birth",
    "description": "Searches members by last name, picks the one with the given date of birth, and returns their member number and name."
  },
  "app": {
    "product": "mock-core-banking",
    "versionRange": ">=1.0 <2.0",
    "surface": "web",
    "entryPath": "/"
  },
  "status": "approved",
  "provenance": {
    "discoveryRunId": "disc_20261116T091044Z_2ecd52",
    "recordedAt": "2026-11-16T09:11:00+00:00",
    "model": "claude-sonnet-5-5"
  },
  "inputs": {
    "lastName": {
      "type": "string",
      "description": "the member's last name",
      "pattern": "^[A-Za-z' -]{2,30}$",
      "sensitive": true
    },
    "dob": {
      "type": "string",
      "description": "date of birth, MM/DD/YYYY",
      "pattern": "^[0-9]{2}/[0-9]{2}/[0-9]{4}$",
      "sensitive": true,
      "identifies": "member"
    }
  },
  "outputs": {
    "memberNumber": {
      "type": "string",
      "redact": "none"
    },
    "memberName": {
      "type": "string",
      "redact": "none"
    }
  },
