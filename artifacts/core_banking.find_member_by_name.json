    {
      "code": "MEMBER_NOT_FOUND",
      "kind": "business",
      "at": "any",
      "detect": {
        "kind": "visible",
        "text": {
          "matches": "(?i)No members found for"
        }
      },
      "description": "The search returned a \"No members found\" message for the last name entered, so no member record matched and none could be opened. (learned from probe: a last name no member has)"
    }
  ],
